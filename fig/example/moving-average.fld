let nthPad n xs = nth (min (max n 0) (length xs - 1)) xs;
let movingAvg ys window =
      [ sum [ nthPad n ys | n $\leftarrow$ is ] / (1 + 2 $\ast$ window)
      | i $\leftarrow$ [ 0 .. length ys - 1 ],
        let is = [ i - window .. i + window ] ];
let movingAvg' rs window =
      zipWith (fun x y $\rightarrow$ {x: x, y: y})
         (map (fun r $\rightarrow$ r.x) rs)
         (movingAvg (map (fun r $\rightarrow$ r.y) rs) window);
let points =
      [ { x: r.year, y: r.emissions } | r $\leftarrow$ methane, r.type == "Agriculture" ]
in LineChart {
   tickLabels: { x: Rotated, y: Default },
   size: { width: 330, height: 285 },
   caption: "SSP5-8.5 projected methane emissions (Agriculture)",
   plots: [
      LinePlot { name: "Original curve", points: points },
      LinePlot { name: "Moving average", points: movingAvg' points 1 }
   ] }

let energy year c_name =
    let filteredRen = filter (check_c year c_name) ren;
    let renOut = sum (map (fun x $\rightarrow$ x.output) filteredRen);
    let renCap = sum (map (fun x $\rightarrow$ x.capacity) filteredRen);
    let nonRenX = 
      head (filter (check_c year c_name) non_ren);
    let totalNonren = 
      nonRenX.nuclearCap + nonRenX.petrolCap
      + nonRenX.gasCap + nonRenX.coalCap;
    in {
      name: c_name,
      totalCap: renCap + totalNonren,
      non_ren: totalNonren,
      renCapFactor: renOut / renCap
    }
in ScatterPlot {
    caption: "Efficiency of renewables vs proportion of cap",
    data: [{
            x: country.non_ren / country.totalCap,
            y: country.renCapFactor,
            c: country.name
           }| country <- map (energy 2018) 
                         ["BRA", "CHN", "DEU", "FRA", "EGY"
                         ,"IND", "JPN", "MEX", "NGA", "USA"]],
    xlabel: "ren/TotalEnergyCap",
    ylabel: "Clean Capacity Factor"
}

let energy year c_names =
  let rens2018 = filter (year_check year) renewables;
  let nonrens2018 = filter (year_check year) non_renewables;
  let energy_per_country c_name =  
    let filteredRen = filter (country_check c_name) rens;
    let rensOut = sum (map (fun x $\rightarrow$ x.output) rens2018);
    let rensCap = sum (map (fun x $\rightarrow$ x.capacity) rens2018);
    let non_ren_x =
      head (filter (check_c year c_name) nonrens2018);
    let totalNonRens = sumNonrens non_ren_x
    in {
        name: c_name,
        totalCap: rensCap + totalNonRens,
        non_rens: totalNonRens,
        renCapFactor: (rensOut + non_ren_x.nuclearOut) 
                        / (rensCap + non_ren_x.nuclearCap)
        }
in ScatterPlot {
    caption:
      "Efficiency of renewables against proportion of cap",
    data: [{
            x: country.non_rens / country.totalCap,
            y: country.renCapFactor,
            c: country.name
        }| country <- energy 2018
                        ["BRA", "CHN", "DEU", "FRA", "EGY"
                        ,"IND", "JPN", "MEX", "NGA", "USA"]],
    xlabel: "rens/TotalEnergyCap",
    ylabel: "Clean Capacity Factor"
}
  
let nextIndices n m window =
  [(i, j) | i $\leftarrow$ [1 .. n], j $\leftarrow$ [max 1 (i - window) .. min m (i + window)]];
let costMatrixInit rows cols window =
    $\llbracket$ let initV = if ((n == 1) `and` (m == 1)) `or` ((abs n m <= window)
                                `and` not ((n == 1) `or` (m == 1)))
                   then FNum 0  else Infty
        in initV | (n, m) in (rows, cols) $\rrbracket$;
let minAndPrev (i, j) im1 jm1 ijm1 =
  let minim = minimal [im1, jm1, ijm1] in
      if minim `eq` im1 then ((i, j + 1), minim)
      else if minim `eq` jm1 then ((i + 1, j ), minim) else ((i, j), minim);
let extractPath indmatrix (i, j) =
  let traverser (n, m) accum =
      if (n == 1) `and` (m == 1) then accum
      else traverser (indmatrix!(n, m)) ((n - 1, m - 1) : accum)
  in traverser (i, j) Nil;
let localMinUpdate seq1 seq2 cost (costmatrix, indmatrix) (i, j) =
    let iEntr = nth (i - 1) seq1;
        jEntr = nth (j - 1) seq2;
        dist = cost iEntr jEntr;
        ip = i + 1;
        jp = j + 1;
        im1 = costmatrix!(i , jp);
        jm1 = costmatrix!(ip, j);
        im1jm1 = costmatrix!(i, j);
        (prev, FNum minim) = minAndPrev (i, j) im1 jm1 im1jm1;
        newVal = FNum (dist + minim)
    in (matrixUpdate costmatrix (ip, jp) newVal, matrixUpdate indmatrix (ip, jp) prev);
let computeDTW seq1 seq2 cost window =
  let n = length seq1;
      m = length seq2;
      initD = costMatrixInit (n + 1) (m + 1) window;
      initI = $\llbracket$ 0 | (i,j) in (n + 1, m + 1)$\rrbracket$;
      indexing = nextIndices n m window;
      (finished, indices) = foldl (localMinUpdate seq1 seq2 cost) (initD, initI) indexing
  in (finished, extractPath indices (n + 1, m + 1));
let d x y = (x - y) * (x - y) in
let seq1 = [3, 1, 2, 2, 1];
    seq2 = [2, 0, 0, 3, 3, 1, 0];
    window = 2;
    (costs, matched) = computeDTW seq1 seq2 d window
in matched
